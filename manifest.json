{
  "manifest_version": 3,
  "name": "PocketResume",
  "version": "10.11.0",
  "description": "Tailor your resume to any job posting on-device. No API key, no quota, no rate limit.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "https://*.convex.cloud/*",
    "https://*.clerk.accounts.dev/*",
    "https://clerk.pocket-resume.xyz/*",
    "https://text.pollinations.ai/*",
    "https://www.onetcenter.org/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}
