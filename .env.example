# Pro (Clerk) + analytics backend env (copy to .env.local, fill in your own values)
# .env.local is gitignored. Never commit real keys.

# Clerk (https://dashboard.clerk.com) — Pro sign-in, plan gating, pricing table
# Publishable key — safe to ship in client code, but use a test key for dev.
CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Clerk Frontend API URL (used by convex/auth.config.ts)
# e.g. https://your-app-12.clerk.accounts.dev
CLERK_FRONTEND_API_URL=https://replace-me.clerk.accounts.dev

# Convex (https://dashboard.convex.dev)
# Public Convex deployment URL for resume cloud sync + the analytics backend.
CONVEX_URL=https://replace-me.convex.cloud

# Local Convex dev deployment (used by `npx convex dev`).
# Format: dev:<deployment-name>
CONVEX_DEPLOYMENT=dev:replace-me
CONVEX_SITE_URL=https://replace-me.convex.site

# Server-side only: extend a pre-Dec-31 subscriber's trial to Jan 7, 2027.
# Set it on the Convex deployment, never in the extension bundle:
#   npx convex env set CLERK_SECRET_KEY sk_live_or_test_...
CLERK_SECRET_KEY=

# Server-side only: send Settings → Feedback mail through Resend (https://resend.com).
# The key stays on the Convex deployment and is never in the extension bundle:
#   npx convex env set RESEND_API_KEY re_xxxxxxxx
RESEND_API_KEY=

# Where feedback mail is delivered. Defaults to feedback@pocket-resume.xyz.
#   npx convex env set FEEDBACK_TO_EMAIL you@example.com
FEEDBACK_TO_EMAIL=

# Optional: a verified sender address. Defaults to onboarding@resend.dev,
# which Resend only allows to send to the account's own address.
#   npx convex env set FEEDBACK_FROM_EMAIL "PocketResume <feedback@pocket-resume.xyz>"
FEEDBACK_FROM_EMAIL=
